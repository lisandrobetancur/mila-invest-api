# Entorno: dev | test | prod
APP_ENV=dev

# Servidor
HOST=0.0.0.0
PORT=8000

# Base de datos
DATABASE_URL=postgres://mila:mila@localhost:5432/mila
DB_POOL_SIZE=10

# Secretos (en prod son obligatorios; estos son valores de ejemplo)
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
DOCUMENT_PEPPER=dev-pepper-change-me-0123456789abcdef

# CORS: lista separada por comas
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Mercado simulado
PRICE_SEED=20261118
MARKET_ALWAYS_OPEN=true

# Rate limit (peticiones por minuto)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_DEFAULT=120

# Logs
LOG_LEVEL=info
